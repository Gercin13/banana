# --- Nano Studio (Vercel) ---

# REQUIRED: WaveSpeed AI API key (wavespeed.ai → Dashboard → API Keys).
WAVESPEED_API_KEY=your_key_here

# REQUIRED: NVIDIA API key (build.nvidia.com/settings) for FLUX.1-dev ("Быстро").
NVIDIA_API_KEY=your_key_here

# REQUIRED: Vercel Blob token (auto-set when Blob store is linked in Vercel dashboard).
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# OPTIONAL: Atomesus prompt enhancement.
# ATOMESUS_API_KEY=atms_sk_...
